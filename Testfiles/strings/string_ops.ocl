/#
  String processing: reversal, palindromes, run-length coding, Caesar cipher,
  letter frequencies, base conversion and the string built-ins.
  strSplit is deliberately not used (it only returns a count, see
  language/known_limitations.ocl).
#/
Let LOWER = "abcdefghijklmnopqrstuvwxyz";
Let UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";

func string reverse(s:string) {
    string res = "";
    for (int i = strLen(s) - 1; i >= 0; i = i - 1) {
        res = res + substr(s, i, 1);
    }
    return res;
}

func bool is_palindrome(s:string) {
    string t = toLowerCase(strReplace(strReplace(s, " ", ""), ",", ""));
    return t == reverse(t);
}

func int count_vowels(s:string) {
    int count = 0;
    for (int i = 0; i < strLen(s); i = i + 1) {
        if (strContains("aeiouAEIOU", substr(s, i, 1))) {
            count = count + 1;
        }
    }
    return count;
}

func string caesar(s:string, shift:int) {
    string res = "";
    for (int i = 0; i < strLen(s); i = i + 1) {
        string c = substr(s, i, 1);
        int lo = strIndexOf(LOWER, c);
        int up = strIndexOf(UPPER, c);
        if (lo >= 0) {
            res = res + substr(LOWER, (lo + shift) % 26, 1);
        } else if (up >= 0) {
            res = res + substr(UPPER, (up + shift) % 26, 1);
        } else {
            res = res + c;
        }
    }
    return res;
}

func string rle_encode(s:string) {
    string res = "";
    int n = strLen(s);
    int i = 0;
    while (i < n) {
        string c = substr(s, i, 1);
        int j = i;
        while (j < n && substr(s, j, 1) == c) {
            j = j + 1;
        }
        res = res + c + toString(j - i);
        i = j;
    }
    return res;
}

func string rle_decode(s:string) {
    string res = "";
    int n = strLen(s);
    int i = 0;
    while (i < n) {
        string c = substr(s, i, 1);
        i = i + 1;
        int count = 0;
        while (i < n && strContains("0123456789", substr(s, i, 1))) {
            count = count * 10 + toInt(substr(s, i, 1));
            i = i + 1;
        }
        for (int k = 0; k < count; k = k + 1) {
            res = res + c;
        }
    }
    return res;
}

func string letter_frequencies(s:string) {
    Let counts = arrayNew(26);
    for (int i = 0; i < 26; i = i + 1) {
        counts[i] = 0;
    }
    string lowered = toLowerCase(s);
    for (int j = 0; j < strLen(lowered); j = j + 1) {
        int idx = strIndexOf(LOWER, substr(lowered, j, 1));
        if (idx >= 0) {
            counts[idx] = counts[idx] + 1;
        }
    }
    string res = "";
    for (int k = 0; k < 26; k = k + 1) {
        if (counts[k] > 0) {
            if (res != "") {
                res = res + " ";
            }
            res = res + substr(LOWER, k, 1) + toString(counts[k]);
        }
    }
    return res;
}

func string to_binary(n:int) {
    if (n == 0) {
        return "0";
    }
    string res = "";
    int rest = n;
    while (rest > 0) {
        res = toString(rest % 2) + res;
        rest = rest / 2;
    }
    return res;
}

func int parse_binary(s:string) {
    int value = 0;
    for (int i = 0; i < strLen(s); i = i + 1) {
        value = value * 2 + toInt(substr(s, i, 1));
    }
    return value;
}

func int word_count(s:string) {
    string t = strTrim(s);
    if (strLen(t) == 0) {
        return 0;
    }
    int words = 1;
    for (int i = 1; i < strLen(t); i = i + 1) {
        if (substr(t, i, 1) == " " && substr(t, i - 1, 1) != " ") {
            words = words + 1;
        }
    }
    return words;
}

func main() {
    print(reverse("OCL interpreter"));
    printf("palindromes: %b %b %b\n": is_palindrome("A man, a plan, a canal, Panama"), is_palindrome("Was it a car or a cat I saw"), is_palindrome("OCL is fun"));
    printf("vowels in 'Programming Language': %d\n": count_vowels("Programming Language"));

    string secret = caesar("Hello, World!", 3);
    print(secret);
    print(caesar(secret, 23));
    assert(caesar(caesar("The Quick Brown Fox", 13), 13) == "The Quick Brown Fox", "ROT13 must be an involution");

    print(rle_encode("aaabccddddd"));
    print(rle_decode(rle_encode("aaabccddddd")));
    print(rle_encode("aaaaaaaaaaaa"));
    assert(rle_decode("a12") == "aaaaaaaaaaaa", "multi-digit run lengths");
    assert(rle_encode("") == "", "empty string encodes to empty string");
    assert(rle_decode(rle_encode("zzzzyx")) == "zzzzyx", "rle round trip");

    print(letter_frequencies("Mississippi River"));

    printf("%d in binary is %s, back again: %d\n": 2026, to_binary(2026), parse_binary(to_binary(2026)));
    print(to_binary(0));

    printf("word count: %d %d %d\n": word_count("  the quick  brown fox "), word_count(""), word_count("one"));

    /# built-in string functions #/
    print(strReplace("a-b-c-d", "-", "+"));
    print(strTrim("  \t padded text \n "));
    print(toUpperCase("mixed Case 123"));
    print(toLowerCase("MIXED Case 123"));
    printf("indexOf: %d %d %d\n": strIndexOf("hello world", "o"), strIndexOf("hello world", "world"), strIndexOf("hello world", "xyz"));
    printf("contains: %b %b\n": strContains("hello world", "lo w"), strContains("hello world", "LO"));
    print(substr("hello world", 6));
    print(substr("hello world", 0, 5));

    /# equality compares content, not identity #/
    string built = "ab" + "c";
    printf("equality: %b %b\n": built == "abc", built != "abd");

    /# concatenation in a loop #/
    string long_text = "";
    for (int i = 0; i < 100; i = i + 1) {
        long_text = long_text + "ab";
    }
    printf("long string: length %d, first 'ba' at %d\n": strLen(long_text), strIndexOf(long_text, "ba"));
}
